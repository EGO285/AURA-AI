# ============================================================
#  NOVA AI — Variables d'environnement
#  Copie ce fichier en ".env" et remplis tes clés (toutes GRATUITES)
# ============================================================

# --- Hugging Face (chat texte + vision + génération d'images) ---
# Crée un token gratuit ici : https://huggingface.co/settings/tokens
# (type "Read" suffit). Le free tier donne un crédit mensuel d'inférence.
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Modèle de chat + vision (voit les images). Doit être un modèle "vision-language".
# Défaut recommandé (gratuit, rapide, multilingue) :
HF_CHAT_MODEL=Qwen/Qwen3.8-27B

# Modèle de génération d'images (texte -> image). Gratuit et rapide :
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell

# --- Tavily (recherche web) ---
# Clé gratuite ici : https://app.tavily.com  (1000 crédits/mois gratuits)
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Serveur ---
PORT=3000
