# ============================================================
#  AURA (powered by EGO) — variables d'environnement
#  Copie ce fichier en ".env" et remplis tes clés.
# ============================================================

# ---------- CHAT (texte + vision) ----------
# N'importe quel endpoint compatible OpenAI. Défaut = Groq (GRATUIT, sans carte).
#
#  >>> Recommandé : GROQ <<<
#  Clé gratuite : https://console.groq.com/keys
CHAT_BASE_URL=https://api.groq.com/openai/v1
CHAT_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CHAT_MODEL=llama-3.1-8b-instant
# Pour la VISION (analyse d'images) sur Groq, utilise plutôt un modèle multimodal, ex :
#   CHAT_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
#
#  --- Autres fournisseurs possibles (mêmes 3 variables) ---
#  OpenRouter (modèles ":free") : CHAT_BASE_URL=https://openrouter.ai/api/v1
#  Hugging Face                 : CHAT_BASE_URL=https://router.huggingface.co/v1

# ---------- IMAGES ----------
# "pollinations" = GRATUIT et SANS CLÉ (défaut). "hf" = Hugging Face (nécessite HF_TOKEN + crédits).
IMAGE_PROVIDER=pollinations
# (utilisé seulement si IMAGE_PROVIDER=hf)
HF_TOKEN=
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell

# ---------- RECHERCHE WEB ----------
# Clé gratuite (1000 crédits/mois) : https://app.tavily.com
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------- Serveur ----------
PORT=3000
